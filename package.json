{
  "name": "dsh-hyper-mode-workspace",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "dsh-hyper-mode 的 pnpm 工作区：一个元包（packages/bundle）加每个插件一个真实包。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/chrock-studio/dsh-hyper-mode.git"
  },
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=24.9.0"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "clean": "bun scripts/clean.ts",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && pnpm -r --no-bail test",
    "check": "pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "tsdown": "^0.23.7",
    "typescript": "^5.9.3"
