{
  "name": "@chrock-studio/dsh-hyper-wiki-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Wiki 标签页的浏览器半边：会话级 Wiki 视图，数据走 Host 的 /wiki 路由",
  "exports": {
    "./client": "./client/client.js"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
