{
  "name": "dsh-wiki",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Convention-first Markdown wiki for DeepSeek Harness: a `wiki` tool for agents, a draft review panel for humans, and per-scope git history.",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "lib",
    "client",
    "skills",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "VERIFY.md"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "bundle",
    "plugin",
    "wiki",
    "markdown"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
